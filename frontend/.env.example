# === FRONTEND ENVIRONMENT VARIABLES ===
# Copy to .env.local for local development
# For production, Vercel will use variables set in project settings

# === API ===
# Local: http://localhost:3001
# Production: https://your-backend-domain.render.com
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_APP_NAME=Conference


# === CLOUDINARY ===
# Get from https://cloudinary.com/console
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloud_name

# === PAYMENT PROVIDERS ===
# Payment provider selection for frontend redirect flow
NEXT_PUBLIC_PAYMENT_PROVIDER=stripe
NEXT_PUBLIC_PAYMENT_TEST_PROVIDER=stripe
NEXT_PUBLIC_PAYMENT_DEV_MODE=true

# Public keys / checkout links
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_STRIPE_PAYMENT_LINK_SPEAKER=https://buy.stripe.com/...
NEXT_PUBLIC_STRIPE_PAYMENT_LINK_POSTER=https://buy.stripe.com/...
NEXT_PUBLIC_STRIPE_PAYMENT_LINK_STUDENT=https://buy.stripe.com/...
NEXT_PUBLIC_STRIPE_PAYMENT_LINK_DELEGATE=https://buy.stripe.com/...
NEXT_PUBLIC_STRIPE_PAYMENT_LINK_VIRTUAL=https://buy.stripe.com/...

NEXT_PUBLIC_PAYPAL_CLIENT_ID=your-paypal-client-id
NEXT_PUBLIC_PAYPAL_PAYMENT_LINK_SPEAKER=https://www.paypal.com/...
NEXT_PUBLIC_PAYPAL_PAYMENT_LINK_POSTER=https://www.paypal.com/...
NEXT_PUBLIC_PAYPAL_PAYMENT_LINK_STUDENT=https://www.paypal.com/...
NEXT_PUBLIC_PAYPAL_PAYMENT_LINK_DELEGATE=https://www.paypal.com/...
NEXT_PUBLIC_PAYPAL_PAYMENT_LINK_VIRTUAL=https://www.paypal.com/...

# === RAZORPAY (Optional) ===
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_RAZORPAY_TEST_PAYMENT_LINK=

# === APP SETTINGS ===
NEXT_PUBLIC_SITE_URL=https://renewableenergy2027.com
NEXT_PUBLIC_SUPPORT_EMAIL=support@yourdomain.com

