# === BACKEND ENVIRONMENT VARIABLES ===
# Copy this file to .env and update with your values

# === DATABASE (MySQL) ===
# Example MySQL connection string for local or cloud MySQL
# Format: mysql://user:password@host:3306/database
DATABASE_URL="mysql://user:password@localhost:3306/conference_db"
# For Aiven, use the Service URI with ?ssl-mode=REQUIRED and add its CA certificate below.
# Prefer the base64 form because it works reliably in hosting-provider environment variables:
# MYSQL_SSL_CA_BASE64="base64-encoded-Aiven-CA-certificate"
# MYSQL_SSL_CA="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"

# === JWT ===
JWT_SECRET="replace_with_a_long-random-secret-at-least-32-characters"
JWT_EXPIRATION="1800s"

# === API ===
API_PORT=3001
NODE_ENV=production

# === FRONTEND URLs (CORS) ===
# For local development: http://localhost:3000,http://localhost:5173
# For production: https://yourdomain.com,https://www.yourdomain.com
FRONTEND_URL="http://localhost:3000"

# === PAYMENT PROVIDERS ===
# In production, use `sandbox` with Razorpay test keys for testing, or `production`
# with live keys to accept real payments. Live keys are never accepted in sandbox mode.
PAYMENT_PROVIDER="stripe"
PAYMENT_MODE="sandbox"

# Stripe
STRIPE_SECRET_KEY="sk_test_xxxxxxxxxxxxxxxxxxxxx"
STRIPE_WEBHOOK_SECRET="whsec_xxxxxxxxxxxxxxxxxxxxx"
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_xxxxxxxxxxxxxxxxxxxxx"

# Razorpay
RAZORPAY_KEY_ID="rzp_test_xxxxxxxxxxxxxxxxxxxxx"
RAZORPAY_KEY_SECRET="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
RAZORPAY_WEBHOOK_SECRET="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
# Razorpay settles in INR: USD plan prices are converted at this rate before the gateway order.
RAZORPAY_USD_TO_INR=90

# PayPal
PAYPAL_CLIENT_ID="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
PAYPAL_CLIENT_SECRET="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
# This is the webhook ID from PayPal's dashboard (not a client secret).
PAYPAL_WEBHOOK_ID="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# PhonePe
PHONEPE_MERCHANT_ID="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
PHONEPE_SALT_KEY="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
PHONEPE_SALT_INDEX="1"
PHONEPE_WEBHOOK_SECRET="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# === CLOUDINARY (Image Storage) ===
# Get from https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="your_api_key"
CLOUDINARY_API_SECRET="your_api_secret"

# === RESEND (Email Service) ===
# Get API key from https://resend.com/api-keys
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxx"
EMAIL_FROM="noreply@yourdomain.com"

# === ADMIN BOOTSTRAP ===
# These are used only on first startup to create admin user
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change_me_in_production"
ADMIN_FIRST_NAME="Admin"
ADMIN_LAST_NAME="User"
